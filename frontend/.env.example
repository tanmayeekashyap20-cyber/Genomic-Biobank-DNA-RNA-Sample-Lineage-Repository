# PostgreSQL used by the app and by `npm run db:setup`.
# Point this at the Windows PostgreSQL service, not a WSL instance.
DATABASE_URL="postgresql://postgres:<password>@127.0.0.1:5432/genomic_biobank_test"

# Secret used to sign session cookies (at least 32 characters).
AUTH_SECRET=

# MongoDB connection string (used by MongoDB-backed routes).
MONGODB_URI=

# Optional: `npm run db:setup` creates/updates this Admin login.
# SEED_ADMIN_USERNAME=admin
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
